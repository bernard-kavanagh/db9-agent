# Required env vars for Vercel deployment — set in Vercel dashboard
TIDB_CONNECTION_STRING=mysql+pymysql://user:pass@host:port/db?ssl_verify_cert=true
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=set-in-vercel-dashboard
SESSION_SECRET=generate-a-long-random-string-here
